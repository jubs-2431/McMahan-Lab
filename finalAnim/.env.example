OPENAI_API_KEY=your_openai_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Optional tuning
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a concise, natural-sounding assistant. Keep replies short.
AZURE_VOICE_MALE=en-US-BrianNeural
AZURE_VOICE_FEMALE=en-US-JennyNeural
WEB_APP_PORT=8002

# Legacy/optional. Active participant routes use Azure Speech.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-orion-en
